<launch>
  <rosparam file="$(find on_orbit)/config/cw_params/cw.yaml"/>
  <rosparam file="$(find on_orbit)/config/holo_params/limits.yaml"/>
  <rosparam file="$(find on_orbit)/config/holo_params/cone_slope.yaml"/>
  <rosparam file="$(find on_orbit)/config/experiment_params/experiment.yaml"/>
  <node name="simulator_node" pkg="on_orbit" type="simulator_node_MPC.py" output="screen"/>
  <!--<arg name="sw_rvizconfig" default="$(find on_orbit)/rviz/nozzle_initially_identity_view_rotated_90.rviz" />-->
  <arg name="sw_rvizconfig" default="$(find on_orbit)/rviz/mrv_client.rviz" />
  <node name="sw_rviz" pkg="rviz" type="rviz" args="-d $(arg sw_rvizconfig)" required="true" />

  <param name="sw_robot_description" textfile="$(find on_orbit)/urdf/robot_cv_detached.urdf" />
  <node name="sw_robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <remap from="joint_states" to="/on_orbit/sw_joint_state" />
    <remap from="robot_description" to="sw_robot_description" />
  </node>
</launch>
