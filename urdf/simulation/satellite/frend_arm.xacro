<?xml version="1.0" ?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="FREND">

<xacro:macro name="frend_arm" params="prefix">
  <xacro:property name="mass_scale" value="1" />
  <xacro:property name="rval" value="0.7"/>
  <xacro:property name="gval" value="0.7"/>
  <xacro:property name="bval" value="0.7"/>

  <mujoco>
    <compiler fusestatic="false" inertiafromgeom="false" />
  </mujoco>

  <link name="${prefix}link0">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0894"/>
      <geometry>
        <cylinder length="0.178765" radius="0.1"/> <!-- We make link0 half the length of D1 in NG's doc.-->
      </geometry>
      <material name="black">
        <color rgba="${rval} ${gval} ${bval} 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="${15.8469*mass_scale}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="${0.089080800*mass_scale}" ixy="0" ixz="0"
               iyy="${0.089080800*mass_scale}" iyz="0" izz="${0.07923450*mass_scale}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0894"/>
      <geometry>
        <cylinder length="0.178765" radius="0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint/Link 1-->
  <joint name="${prefix}joint1" type="revolute">
  <parent link="${prefix}link0"/>
    <child link="${prefix}link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.178765"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="150.0" lower="-2.792526803" upper="2.792526803" velocity="0.06981317008"/>
  </joint>

  <link name="${prefix}link1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.0894"/>
      <geometry>
        <cylinder length="0.178765" radius="0.045"/>
      </geometry>
      <material name="black">
        <color rgba="${rval} ${gval} ${bval} 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="${21.4021*mass_scale}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="${0.07836099*mass_scale}" ixy="0" ixz="0"
               iyy="${0.07836099*mass_scale}" iyz="0" izz="${0.02675263*mass_scale}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.0894"/>
      <geometry>
        <cylinder length="0.178765" radius="0.045"/>
      </geometry>
    </collision>
  </link>

 <!-- Joint/Link 2-->
  <joint name="${prefix}joint2" type="revolute">
  <parent link="${prefix}link1"/>
    <child link="${prefix}link2"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0 0 0.178765"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="150.0" lower="-1.745329252" upper="1.745329252" velocity="0.06981317008"/>
  </joint>

    <link name="${prefix}link2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.12954"/>
      <geometry>
        <cylinder length="0.15908" radius="0.045"/>
      </geometry>
      <material name="black">
        <color rgba="${rval} ${gval} ${bval} 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="${16.5794*mass_scale}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="${0.11988023*mass_scale}" ixy="0" ixz="0"
               iyy="${0.11988023*mass_scale}" iyz="0" izz="${0.02072425*mass_scale}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.12954"/>
      <geometry>
        <cylinder length="0.15908" radius="0.045"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint/Link 3-->
  <joint name="${prefix}joint3" type="revolute">
  <parent link="${prefix}link2"/>
    <child link="${prefix}link3"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0.25908"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="150.0" lower="-2.967059728" upper="2.565634" velocity="0.1047197551"/>
  </joint>

    <link name="${prefix}link3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.45"/>
      <geometry>
        <cylinder length="0.8" radius="0.045"/>
      </geometry>
      <material name="black">
        <color rgba="${rval} ${gval} ${bval} 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="${18.0461*mass_scale}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="${1.43189056*mass_scale}" ixy="0" ixz="0"
               iyy="${1.43189056*mass_scale}" iyz="0" izz="${0.0255763*mass_scale}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.45"/>
      <geometry>
        <cylinder length="0.8" radius="0.045"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint/Link 4-->
  <joint name="${prefix}joint4" type="revolute">
  <parent link="${prefix}link3"/>
    <child link="${prefix}link4"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0 0 0.9"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="150.0" lower="-2.967059728" upper="2.617993878" velocity="0.1047197551"/>
  </joint>

  <link name="${prefix}link4">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.111125"/>
      <geometry>
        <cylinder length="0.12225" radius="0.045"/>
      </geometry>
      <material name="black">
        <color rgba="${rval} ${gval} ${bval} 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="${9.7351*mass_scale}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>    
      <inertia ixx="${0.05850536*mass_scale}" ixy="0" ixz="0"
               iyy="${0.05850536*mass_scale}" iyz="0" izz="${0.01216888*mass_scale}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.111125"/>
      <geometry>
        <cylinder length="0.12225" radius="0.045"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint/Link 5-->
  <joint name="${prefix}joint5" type="revolute">
  <parent link="${prefix}link4"/>
    <child link="${prefix}link5"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 -0.22225"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="150.0" lower="-4.36332313" upper="2.617993878" velocity="0.1221730476"/>
  </joint>

  <link name="${prefix}link5">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.450085"/>
      <geometry>
        <cylinder length="0.8017" radius="0.045"/>
      </geometry>
      <material name="black">
        <color rgba="${rval} ${gval} ${bval} 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="${7.7539*mass_scale}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>      
      <inertia ixx="${0.73100869*mass_scale}" ixy="0" ixz="0"
               iyy="${0.73100869*mass_scale}" iyz="0" izz="${0.00969238*mass_scale}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.4500"/>
      <geometry>
        <cylinder length="0.8017" radius="0.045"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint/Link 6-->
  <joint name="${prefix}joint6" type="revolute">
  <parent link="${prefix}link5"/>
    <child link="${prefix}link6"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0 0 0.90017"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="150.0" lower="-1.919862177" upper="1.919862177" velocity="0.1221730476"/>
  </joint>

  <link name="${prefix}link6">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
      <material name="black">
        <color rgba="${rval} ${gval} ${bval} 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="${5.5820*mass_scale}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>      
      <inertia ixx="${0.01064042*mass_scale}" ixy="0" ixz="0"
               iyy="${0.01064042*mass_scale}" iyz="0" izz="${0.00697750*mass_scale}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.045"/>
      </geometry>
    </collision>
  </link>

  <!--Joint/Link 7-->
  <joint name="${prefix}joint7" type="revolute">
  <parent link="${prefix}link6"/>
    <child link="${prefix}link7"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0" friction="0"/>
    <limit effort="150.0" lower="-4.310963252" upper="1.169370599" velocity="0.12217304762"/>
  </joint>

  <link name="${prefix}link7">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0.20395"/>
      <geometry>
        <cylinder length="0.3079" radius="0.045"/>
      </geometry>
      <material name="black">
        <color rgba="${rval} ${gval} ${bval} 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="${5.2186*mass_scale}"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>      
      <inertia ixx="${0.11721416*mass_scale}" ixy="0" ixz="0"
               iyy="${0.11721416*mass_scale}" iyz="0" izz="${0.00652325*mass_scale}"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.20395"/>
      <geometry>
        <cylinder length="0.3079" radius="0.045"/>
      </geometry>
    </collision>
  </link>

  <!-- Wrist joint -->
  <joint name="${prefix}wrist_joint" type="fixed">
  <parent link="${prefix}link7"/>
    <child link="${prefix}wrist"/>
    <origin rpy="0 0 0" xyz="0 0 0.2979"/>
  </joint>

  <link name="${prefix}wrist">
      <inertial>
      <mass value="0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>        
      <inertia ixx="0" ixy="0" ixz="0"
               iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

</xacro:macro>
</robot>
