<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="single_rail_2">

  <!-- load macros -->
  <xacro:include filename="$(find on_orbit)/urdf/hardware/ur/ur_3_ur10e.xacro" />
  <xacro:include filename="$(find on_orbit)/urdf/hardware/ur/ur_4_ur10e.xacro" />

  <xacro:macro name="rail_2" >

    <link
      name="rail_2">
      <inertial>
        <origin
          xyz="2.9985 0.2535 0.089"
          rpy="0 0 0" />
        <mass
          value="541.21" />
        <inertia
          ixx="13.022"
          ixy="9.7404E-15"
          ixz="0"
          iyy="1623.4"
          iyz="-2.1269E-17"
          izz="1633.6" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://on_orbit/urdf/hardware/rails/meshes/rail_1.STL" />
        </geometry>
        <material
          name=""> 
          <color
            rgba="0.15 0.18 0.4 1"  />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://on_orbit/urdf/hardware/rails/meshes/rail_1.STL" />
        </geometry>
      </collision>
    </link>
    <link
      name="carriage_link_4">
      <inertial>
        <origin
          xyz="0.314 0.25761 0.072655"
          rpy="0 0 0" />
        <mass
          value="38.774" />
        <inertia
          ixx="0.85293"
          ixy="-3.0968E-18"
          ixz="-9.2339E-17"
          iyy="1.2302"
          iyz="-0.031796"
          izz="1.8032" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://on_orbit/urdf/hardware/rails/meshes/carriage_link_2.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.25 0.36 0.56 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://on_orbit/urdf/hardware/rails/meshes/carriage_link_2.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="carriage_4"
      type="prismatic">
      <origin
        xyz="0.1995 0.002 0.188"
        rpy="0 0 0" />
      <parent
        link="rail_2" />
      <child
        link="carriage_link_4" />
      <axis
        xyz="1 0 0" />
      <limit
        lower="-5"
        upper="5"
        effort="1000"
        velocity="10" />
    </joint>
    

    <joint
      name="fixed_4"
      type="fixed">
      <origin
        xyz="0.3115 0.23559 0.24216"
        rpy="-0.7854 0 3.14159265359" />
      <parent
        link="carriage_link_4" />
      <child
        link="ur_4_base_link" />
      <axis
        xyz="0 0 0" />
    </joint>


    <link
      name="carriage_link_3">
      <inertial>
        <origin
          xyz="0.314 0.25761 0.072655"
          rpy="0 0 0" />
        <mass
          value="38.774" />
        <inertia
          ixx="0.85293"
          ixy="-7.7233E-18"
          ixz="-3.2943E-17"
          iyy="1.2302"
          iyz="-0.031796"
          izz="1.8032" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://on_orbit/urdf/hardware/rails/meshes/carriage_link_1.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.25 0.36 0.56 1" />
        </material>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="package://on_orbit/urdf/hardware/rails/meshes/carriage_link_1.STL" />
        </geometry>
      </collision>
    </link>
    <joint
      name="carriage_3"
      type="prismatic">
      <origin
        xyz="5.1695 0.002 0.1885"
        rpy="0 0 0" />
      <parent
        link="rail_2" />
      <child
        link="carriage_link_3" />
      <axis
        xyz="-1 0 0" />
      <limit
        lower="-5"
        upper="5"
        effort="1000"
        velocity="10" />
    </joint>


    <joint
      name="fixed_3"
      type="fixed">
      <origin
        xyz="0.3115 0.23559 0.24166"
        rpy="-0.7854 0 3.14159265359" />
      <parent
        link="carriage_link_3" />
      <child
